{
  "name": "entelisteam/lbaf-reflection",
  "description": "Lightweight PHP reflection utilities: enum helper, type caster, short class name resolver, cached method parameter lookup.",
  "type": "library",
  "license": "MIT",
  "keywords": ["reflection", "enum", "type-casting", "helpers", "utility"],
  "authors": [
    {
      "name": "Dim Entelis",
      "email": "dentelis@gmail.com",
      "homepage": "https://entelis.team"
    }
  ],
  "require": {
    "php": "~8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "rector/rector": "^2.3.0",
    "entelisteam/lbaf-rector": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "EntelisTeam\\Lbaf\\Reflection\\": "src/",
      "EntelisTeam\\Lbaf\\Reflection\\Rector\\": "rector/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EntelisTeam\\Lbaf\\Reflection\\Tests\\": "tests/"
    }
  },
  "extra": {
    "lbaf-rector-migrations": "EntelisTeam\\Lbaf\\Reflection\\Rector\\MigrationList"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "rector:check": "vendor/bin/rector process --dry-run",
    "rector:fix": "vendor/bin/rector process",
    "post-update-cmd": "test ! -f vendor/bin/rector || vendor/bin/rector process"
  },
  "minimum-stability": "stable"
}
